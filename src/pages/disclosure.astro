---
import BaseLayout from "../layouts/BaseLayout.astro";

const points = [
  ["Fully AI-generated", "Jane Voss is a synthetic virtual model created with AI workflows."],
  ["Not a real person", "Jane Voss does not exist as a real individual."],
  ["Not based on any real individual", "The project does not intentionally recreate a private person or public figure."],
  ["No deepfakes", "The project does not transform real people into synthetic media."],
  ["No celebrity likeness", "The project does not imply celebrity resemblance, endorsement or identity."],
  ["No underage styling", "All styling and presentation must clearly avoid underage cues."],
  ["All images synthetic", "Any future public images on this site are synthetic and should be reviewed before publication."]
];
---

<BaseLayout
  title="Disclosure | Jane Voss"
  description="AI disclosure for Jane Voss, a fully AI-generated virtual model."
  path="/disclosure"
>
  <section class="page-hero">
    <p class="eyebrow">Disclosure</p>
    <h1>Jane Voss is a synthetic creator.</h1>
    <p class="lede">This page explains the public rules for the Jane Voss project.</p>
  </section>
  <section class="policy-grid" aria-label="Jane Voss AI disclosure points">
    {points.map(([title, text]) => (
      <article>
        <h2>{title}</h2>
        <p>{text}</p>
      </article>
    ))}
  </section>
</BaseLayout>
